{
  "schema_version": "1.0",
  "strategy_id": "rsi_reversal_ref",
  "version": 1,
  "name": "RSI reversal (reference migration)",
  "description": "Mean reversion: long when RSI crosses up through oversold, short when it crosses down through overbought; the position holds only while RSI is inside the neutral band (30, 70) and flattens as soon as it leaves — matches strategies.rsi_reversal.",
  "source": {
    "type": "HUMAN",
    "reference": "mql5bot.strategies.rsi_reversal"
  },
  "hypothesis": {
    "statement": "Escapes from exhaustion levels revert toward the mean.",
    "expected_regime": "RANGE",
    "expected_failure_regime": "TREND_UP/TREND_DOWN",
    "expected_holding_bars": [
      3,
      40
    ],
    "expected_trade_frequency": "medium",
    "risk_assumptions": "Tight ATR stop; failure regime is persistent trends."
  },
  "market": {
    "symbol": "EURUSD",
    "timeframe": "H1"
  },
  "indicators": [
    {
      "id": "rsi_main",
      "kind": "RSI",
      "period": 14,
      "applied": "close"
    }
  ],
  "entry": {
    "mode": "state",
    "long": {
      "cross": "ABOVE",
      "a": {
        "ind": "rsi_main"
      },
      "b": {
        "const": 30
      }
    },
    "short": {
      "cross": "BELOW",
      "a": {
        "ind": "rsi_main"
      },
      "b": {
        "const": 70
      }
    },
    "exit_long": {
      "or": [
        {
          "left": {
            "ind": "rsi_main"
          },
          "cmp": "LE",
          "right": {
            "const": 30
          }
        },
        {
          "left": {
            "ind": "rsi_main"
          },
          "cmp": "GE",
          "right": {
            "const": 70
          }
        }
      ]
    },
    "exit_short": {
      "or": [
        {
          "left": {
            "ind": "rsi_main"
          },
          "cmp": "LE",
          "right": {
            "const": 30
          }
        },
        {
          "left": {
            "ind": "rsi_main"
          },
          "cmp": "GE",
          "right": {
            "const": 70
          }
        }
      ]
    }
  },
  "exit": {
    "sl": {
      "model": "atr",
      "mult": 2.0
    },
    "tp": {
      "model": "atr",
      "mult": 3.0
    }
  },
  "filters": {},
  "risk": {
    "note": "Stops constrain trade geometry only; position risk is authorized solely by the Aegis Risk Engine."
  },
  "metadata": {
    "regime_tags": [
      "mean_reversion"
    ],
    "requires_codegen": false,
    "missing_features": []
  }
}
